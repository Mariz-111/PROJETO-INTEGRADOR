----- SELECTS-----

-- 1. Detalhes e descrição do produto
SELECT nome, preco, descricao, estoque
FROM produto
WHERE id = 1;

-- 2. Validade do cupom
SELECT codigo, desconto
FROM cupom
WHERE codigo = 'BELLEVISAGE10' AND validade >= DATE('now');

-- 3. Exibe o perfil do cliente e seu endereço
SELECT 
    c.nome, 
    c.email, 
    c.telefone,
    e.rua, 
    e.numero, 
    e.cidade, 
    e.estado, 
    e.cep
FROM cliente c
LEFT JOIN endereco e ON e.cliente_id = c.id
WHERE c.id = 1;

-- 4. Simplifica valor das compras
SELECT 
    subtotal, 
    frete, 
    (subtotal + frete) AS valor_total_a_pagar,
    status_pedido
FROM pedido
WHERE cliente_id = 1;
