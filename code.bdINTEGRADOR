-----SELECT-----

---detalhes e descricao do produto
SELECT nome, preco, descricao, estoque
FROM produto
WHERE id = 1;

---validade do cupom
SELECT codigo, desconto
FROM cupom
WHERE codigo = 'BELLEVISAGE10' AND validade
>=DATE('now');

---exibe o perfil do cliente e seu endereco
SELECT 
    c.nome, 
    c.email, 
    c.telefone,
    e.rua, 
    e.numero, 
    e.cidade, 
    e.estado, 
    e.cep
FROM cliente c
LEFT JOIN endereco e ON e.cliente_id = c.id
WHERE c.id = 1;

---simplifica valor das compras
SELECT 
    subtotal, 
    frete, 
    (subtotal + frete) AS valor_total_a_pagar,
    status_pedido
FROM pedido
WHERE cliente_id = 1;
