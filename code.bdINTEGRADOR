----- TABELAS -----

-- 1. CLIENTE
CREATE TABLE IF NOT EXISTS cliente (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nome TEXT NOT NULL,
  telefone TEXT,
  cpf TEXT UNIQUE NOT NULL,
  email TEXT UNIQUE NOT NULL,
  senha TEXT NOT NULL
);

-- 2. PRODUTO
CREATE TABLE IF NOT EXISTS produto (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nome TEXT NOT NULL,
  preco REAL NOT NULL,
  estoque INTEGER NOT NULL DEFAULT 0,
  descricao TEXT
);

-- 3. CUPOM
CREATE TABLE IF NOT EXISTS cupom (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  codigo TEXT UNIQUE NOT NULL,
  desconto REAL NOT NULL,
  validade TEXT NOT NULL
);

-- 4. FORMA DE PAGAMENTO
CREATE TABLE IF NOT EXISTS forma_de_pagamento (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  tipo_de_pagamento TEXT NOT NULL
);

-- 5. COMPRA
CREATE TABLE IF NOT EXISTS compra (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  cliente_id INTEGER NOT NULL,
  produto_id INTEGER NOT NULL,
  metodo_pagamento TEXT NOT NULL,
  status_pagamento TEXT NOT NULL DEFAULT 'Pendente',
  data_pagamento TEXT,
  status_entrega TEXT NOT NULL DEFAULT 'Em processamento',
  frete REAL NOT NULL DEFAULT 0.0,
  cupom_id INTEGER,
  quantidade INTEGER NOT NULL,
  subtotal REAL NOT NULL,
  valor_total REAL NOT NULL,
  FOREIGN KEY (cliente_id) REFERENCES cliente(id),
  FOREIGN KEY (produto_id) REFERENCES produto(id),
  FOREIGN KEY (cupom_id) REFERENCES cupom(id)
);

-- 6. PEDIDO
CREATE TABLE IF NOT EXISTS pedido (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  cliente_id INTEGER NOT NULL,
  data_pedido TEXT NOT NULL,
  pagamento_id INTEGER NOT NULL,
  status_pedido TEXT NOT NULL,
  subtotal REAL NOT NULL,
  frete REAL NOT NULL,
  FOREIGN KEY (cliente_id) REFERENCES cliente(id),
  FOREIGN KEY (pagamento_id) REFERENCES forma_de_pagamento(id)
);

-- 7. ENDEREÇO
CREATE TABLE IF NOT EXISTS endereco (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  cliente_id INTEGER NOT NULL,
  rua TEXT NOT NULL,
  numero TEXT NOT NULL,
  bairro TEXT,
  cidade TEXT,
  estado TEXT,
  cep TEXT,
  complemento TEXT,
  FOREIGN KEY (cliente_id) REFERENCES cliente(id)
);

----- INDEX -----

CREATE INDEX IF NOT EXISTS idx_email ON cliente(email);
CREATE INDEX IF NOT EXISTS idx_cpf ON cliente(cpf);
CREATE INDEX IF NOT EXISTS idx_produto_nome ON produto(nome);
CREATE INDEX IF NOT EXISTS idx_cupom_codigo ON cupom(codigo);
CREATE INDEX IF NOT EXISTS idx_cupom_validade ON cupom(validade);
CREATE INDEX IF NOT EXISTS idx_compra_produto_id ON compra(produto_id);
CREATE INDEX IF NOT EXISTS idx_compra_cupom_id ON compra(cupom_id);
CREATE INDEX IF NOT EXISTS idx_pedido_cliente_id ON pedido(cliente_id);
CREATE INDEX IF NOT EXISTS idx_pedido_pagamento_id ON pedido(pagamento_id);
CREATE INDEX IF NOT EXISTS idx_pedido_data ON pedido(data_pedido);
CREATE INDEX IF NOT EXISTS idx_endereco_cliente_id ON endereco(cliente_id);
CREATE INDEX IF NOT EXISTS idx_endereco_cep ON endereco(cep);
CREATE INDEX IF NOT EXISTS idx_endereco_cidade ON endereco(cidade);

