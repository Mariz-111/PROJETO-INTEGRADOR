-----SELECT-----
--EXIBIR O PRODUTO NO SITE
SELECT nome, preco, descricao
FROM produto
WHERE id = 1;

--VERIFICAR SE EXISTE CUPOM VALIDO
SELECT codigo, desconto
FROM cupom
WHERE validade >= DATE('now');

--SIMULAR VALOR COM DESCONTO(PRODUTO + CUPOM)
SELECT 
  p.nome,
  p.preco,
  c.desconto,
  (p.preco - c.desconto) AS preco_com_desconto
FROM produto p
JOIN cupom c ON c.id = 1
WHERE p.id = 1;

--VER STATUS DE UMA COMPRA
SELECT status_pagamento, status_entrega
FROM compra
WHERE id = 1;

--BUSCAR DADOS DO CLIENTE(PERFIL SIMPLES)
SELECT nome, email
FROM cliente
WHERE id = 1;

--MOSTRAR ENDEREÇO DO CLIENTE
SELECT rua, numero, cidade, estado
FROM endereco
WHERE cliente_id = 1;

--RESUMO DO PEDIDO
SELECT subtotal, frete, (subtotal + frete) AS total
FROM pedido
WHERE cliente_id = 1;
