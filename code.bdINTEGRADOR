-----TABELAS-----

--PRODUTO
CREATE TABLE produto (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nome TEXT NOT NULL,
  preco DECIMAL(10,2),
  estoque VARCHAR(100),
  descricao TEXT
);

--CUPOM
CREATE TABLE cupom (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  codigo VARCHAR(20) UNIQUE,
  desconto DECIMAL(5,2),
  validade DATE
);

--COMPRA
CREATE TABLE compra (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  produto_id INTEGER,
  metodo_pagamento VARCHAR(20),
  status_pagamento VARCHAR(30),
  data_pagamento DATE,
  status_entrega VARCHAR(40),
  frete DECIMAL(10,2),
  cupom_id INTEGER,
  quantidade INTEGER,
  valor_total DECIMAL(10,2),
  FOREIGN KEY (usuario_id) REFERENCES cliente(id),
  FOREIGN KEY (produto_id) REFERENCES produto(id),
  FOREIGN KEY (cupom_id) REFERENCES cupom(id)
);

--CLIENTE
CREATE TABLE cliente (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nome TEXT NOT NULL,
  telefone VARCHAR(13),
  cpf TEXT UNIQUE NOT NULL,
  email TEXT UNIQUE NOT NULL,
  senha TEXT
);

--PAGAMENTO
CREATE TABLE forma_de_pagamento (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  tipo_de_pagamento VARCHAR(20)
);

--PEDIDO
CREATE TABLE pedido (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  cliente_id INTEGER,
  data_pedido DATE,
  pagamento_id INTEGER,
  status_id INTEGER,
  subtotal DECIMAL(6,2),
  frete DECIMAL(6,2),
  FOREIGN KEY (status_id) REFERENCES status_pedido(id),
  FOREIGN KEY (cliente_id) REFERENCES cliente(id),
  FOREIGN KEY (pagamento_id) REFERENCES forma_de_pagamento(id)
);

---ENDEREÇO
CREATE TABLE endereco (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  cliente_id INTEGER,
  rua TEXT NOT NULL,
  numero VARCHAR(10),
  bairro TEXT,
  cidade TEXT,
  estado VARCHAR(2),
  cep VARCHAR(10),
  complemento TEXT,
  FOREIGN KEY (cliente_id) REFERENCES cliente(id)
);

-----INDEX-----


CREATE INDEX idx_email ON cliente(email);
create INDEX idx_cpf ON cliente(cpf);
CREATE INDEX idx_produto_nome ON produto(nome);
CREATE INDEX idx_cupom_codigo ON cupom(codigo);
CREATE INDEX idx_cupom_validade ON cupom(validade);
CREATE INDEX idx_compra_produto_id ON compra(produto_id);
CREATE INDEX idx_compra_cupom_id ON compra(cupom_id);
CREATE INDEX idx_compra_data_pagamento ON compra(data_pagamento);
CREATE INDEX idx_pedido_cliente_id ON pedido(cliente_id);
CREATE INDEX idx_pedido_pagamento_id ON pedido(pagamento_id);
CREATE INDEX idx_pedido_status_id ON pedido(status_id);
CREATE INDEX idx_pedido_data ON pedido(data_pedido);
CREATE INDEX idx_endereco_cliente_id ON endereco(cliente_id);
CREATE INDEX idx_endereco_cep ON endereco(cep);
CREATE INDEX idx_endereco_cidade ON endereco(cidade);
